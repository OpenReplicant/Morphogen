{"default": 2, "description": "1 assist, 2 propose, 3 merge free changes, 4 autonomous", "id": "param/autonomy", "of": "morphogen/operator", "owner": "operator", "range": [1, 4], "set_in": "morphogen.yaml: autonomy", "type": "int"}
{"default": 0, "description": "tool calls per session; 0 means no limit", "id": "param/budget-tool-calls", "of": "morphogen/harness", "owner": "operator", "range": [0, 100000], "set_in": "morphogen.yaml: budget.tool_calls", "type": "int"}
{"default": 20, "description": "judge runs per day; 0 means no limit", "id": "param/budget-trials-per-day", "of": "morphogen/judge", "owner": "operator", "range": [0, 1000], "set_in": "morphogen.yaml: budget.trials_per_day", "type": "int"}
{"default": "haiku", "description": "the explorer's model; cost against quality", "id": "param/explorer-model", "of": "morphogen/explorer", "owner": "operator", "range": ["haiku", "sonnet", "opus"], "set_in": "agents/explorer.md: model", "type": "choice"}
{"default": 30, "description": "rounds a close call may extend to", "id": "param/judge-max-repeats", "of": "morphogen/judge", "owner": "judge", "range": [3, 200], "set_in": "target.yaml: measure.max_repeats (per target); default in server/morphogen/judge.py", "type": "int"}
{"default": 0.05, "description": "the bar a primary metric's gain must clear; set per target", "id": "param/judge-min-improvement", "of": "morphogen/judge", "owner": "judge", "range": [0, 1], "set_in": "target.yaml: measure.metrics.<metric>.min_improvement (per target); default in server/morphogen/judge.py", "type": "float"}
{"default": 10, "description": "paired rounds before the first decision", "id": "param/judge-repeats", "of": "morphogen/judge", "owner": "judge", "range": [3, 100], "set_in": "target.yaml: measure.repeats (per target)", "type": "int"}
{"default": 0.01, "description": "p-value a primary metric's sign test must reach", "id": "param/judge-significance", "of": "morphogen/judge", "owner": "judge", "range": [0.001, 0.05], "set_in": "server/morphogen/judge.py: _compare(alpha=0.01)", "type": "float"}
{"default": 300, "description": "a run's limit before it fails", "id": "param/judge-timeout", "of": "morphogen/judge", "owner": "judge", "range": [1, 3600], "set_in": "target.yaml: timeout (seconds, per target)", "type": "int"}
{"default": "sonnet", "description": "the reviewer's model; cost against quality", "id": "param/reviewer-model", "of": "morphogen/reviewer", "owner": "operator", "range": ["haiku", "sonnet", "opus"], "set_in": "agents/reviewer.md: model", "type": "choice"}
{"default": "auto", "description": "where trials run", "id": "param/sandbox", "of": "morphogen/sandbox", "owner": "operator", "range": ["auto", "docker", "podman", "none"], "set_in": "morphogen.yaml: sandbox", "type": "choice"}
{"default": 30, "description": "how long a SQLite writer waits for the lock", "id": "param/store-busy-timeout", "of": "knowledge/lists", "owner": "agent", "range": [1, 600], "set_in": "server/morphogen/store.py: connect_args timeout (seconds)", "type": "int"}
{"default": 8, "description": "appends retried after losing a race for the next seq", "id": "param/store-retries", "of": "knowledge/logs", "owner": "agent", "range": [1, 50], "set_in": "server/morphogen/store.py: RETRIES", "type": "int"}
{"default": ["hill-climb", "archive-search"], "description": "the order auto tries strategies in", "id": "param/strategy-preference", "of": "morphogen/improvement-strategy", "owner": "operator", "set_in": "server/morphogen/strategies.py: PREFERENCE", "type": "list"}
{"default": 20, "description": "lines a passing change must touch before simplify is tried", "id": "param/strategy-simplify-min-lines", "of": "morphogen/improvement-strategy", "owner": "operator", "range": [1, 500], "set_in": "server/morphogen/strategies.py: SIMPLIFY_MIN_LINES", "type": "int"}
{"default": 4, "description": "verdicts in a row without a pass before a strategy counts as stalled", "id": "param/strategy-stall-trials", "of": "morphogen/improvement-strategy", "owner": "operator", "range": [2, 20], "set_in": "server/morphogen/strategies.py: STALL_TRIALS", "type": "int"}
