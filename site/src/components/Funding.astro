---
// What a trial costs in money and how much of it is funded: a bar, the price, the fraction and a "ready" badge, from
// the queue row's currency, cost_money, pledged, received, funded_fraction, funding_source and ready (research/funding.yaml,
// morphogen.research rank). Nothing at all when the row has no price, i.e. when there is no funding file. The link
// comes from [funding] url_template in the config and is left out without one.
import { fundUrl } from "../lib/config.mjs";
const { site, row } = Astro.props;
const shown = row && typeof row.cost_money === "number";
const money = (v) => `${Number(v || 0).toLocaleString("en-US", { maximumFractionDigits: 2 })} ${row.currency || ""}`.trim();
const frac = shown ? Math.max(0, Math.min(1, Number(row.funded_fraction) || 0)) : 0;
const pct = (frac * 100).toFixed(1);
const href = shown ? fundUrl(site.funding.url_template, row.claim) : null;
---
{shown && <div class="funding"><span class="meter-wrap" title="Share of the price pledged or received"><svg class="meter fund-bar" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true" focusable="false"><rect class="meter-track" x="0" y="0" width="100" height="8" rx="4"/><rect class="meter-fill" x="0" y="0" width={pct} height="8" rx="4"/></svg><span class="meter-num">{Math.round(frac * 100)}% funded</span></span>
<span class="qnum"><span class="f-lab">price</span> <span class="mono">{money(row.cost_money)}</span></span>
<span class="qnum"><span class="f-lab">pledged</span> <span class="mono">{money(row.pledged)}</span></span>
<span class="qnum"><span class="f-lab">received</span> <span class="mono">{money(row.received)}</span></span>
{row.ready && <span class="tag tag-ready">ready</span>}
{row.funding_source && <span class="small muted">Source: {row.funding_source}</span>}
{href && <a class="btn ghost small-btn" href={href} rel="noopener">{site.funding.label}</a>}</div>}
