---
// One role: what it is, the open questions the agent watches for it, its options, what has been tested, what is
// next in the queue, every claim, and every reference to and from it.
import Base from "../../layouts/Base.astro";
import ClaimList from "../../components/ClaimList.astro";
import EntityHead from "../../components/EntityHead.astro";
import Evidence from "../../components/Evidence.astro";
import Meter from "../../components/Meter.astro";
import Mentions from "../../components/Mentions.astro";
import References from "../../components/References.astro";
import ResultsTable from "../../components/ResultsTable.astro";
import StatusCounts from "../../components/StatusCounts.astro";
import { getSite } from "../../lib/site.mjs";
import { proposeOptionUrl } from "../../lib/steer.mjs";
import { refName, truncate } from "../../lib/text.mjs";

export async function getStaticPaths() {
  const site = await getSite();
  return site.of("role").map((r) => ({ params: { name: r.slug }, props: { id: r.id } }));
}
const site = await getSite();
const r = site.entities.get(Astro.props.id);
const parent = site.outs(r, "part-of");
const parts = site.ins(r, "part-of");
const options = site.ins(r, "fills");
const claims = site.ins(r, "role");
const tested = site.results(claims).filter((x) => x.a.outcome || ["replicated", "did-not-transfer", "not-testable"].includes(x.a.status));
const waiting = site.results(claims).filter((x) => x.a.status === "predicted");
const topics = site.topicsFor(r.name);
const queue = site.queue().map((q, i) => ({ ...q, rank: i + 1 })).filter((q) => refName(q.role) === r.name);
---
<Base site={site} title={r.name} description={truncate(r.summary, 160)} depth={1}>
<EntityHead ent={r} eyebrow="Role" crumbs={[["../roles.html", "Roles"]]}>
  <p class="small">{parent.map((p) => <>Part of <a class="mono" href={`../${p.url}`}>{p.name}</a>. </>)}{parts.length > 0 && <>Its parts: {parts.map((p, i) => <>{i > 0 && ", "}<a class="mono" href={`../${p.url}`}>{p.name}</a></>)}. </>}{site.outs(r, "in-system").map((s) => <>In the system <a class="mono" href={`../${s.url}`}>{s.name}</a>.</>)}</p>
  <p><StatusCounts site={site} claims={claims} /></p>
</EntityHead>
<Evidence ent={r} />

<div class="cols">
<section class="panel" aria-labelledby="q-h"><h2 id="q-h">Open questions the agent watches</h2>
  {topics.length ? <ul class="plain">{topics.map((t) => <li><strong class="mono">{t.name}</strong><br>{t.question}{(t.terms || []).length > 0 && <p class="terms">{t.terms.map((x) => <span class="tag">{x}</span>)}</p>}</li>)}</ul>
    : <p class="muted">No watch topic names this role yet (research/watch.yaml).</p>}
</section>
<section class="panel" aria-labelledby="n-h"><h2 id="n-h">Next to test ({queue.length})</h2>
  {queue.length ? <ol class="plain">{queue.map((q) => <li><span class="mono">#{q.rank}</span> <a href={site.claim(q.claim) ? `../${site.claim(q.claim).url}` : undefined}>{site.claim(q.claim)?.title || q.claim}</a> {typeof q.p_transfer === "number" && <Meter p={q.p_transfer} />}</li>)}</ol>
    : <p class="muted">Nothing for this role in the <a href="../queue.html">queue</a>.</p>}
</section>
</div>

<section class="panel" aria-labelledby="o-h"><h2 id="o-h">Options for it ({options.length})</h2>
  <ul class="opts">{options.length ? options.map((o) => {
    const cs = site.ins(o, "about");
    const result = o.spec?.morphogen?.evaluation?.result;
    return <li class="opt"><h4 class="mono"><a href={`../${o.url}`}>{o.name}</a></h4><p>{o.summary}</p><p class="small"><StatusCounts site={site} claims={cs} /></p>{result && <p class="small"><span class="f-lab">Result so far</span> {result}</p>}</li>;
  }) : <li class="muted">None yet.</li>}</ul>
  <p class="actions"><a class="btn ghost" href={proposeOptionUrl(site, r.name)} rel="noopener noreferrer">Suggest an option for this role</a></p>
</section>

<section class="panel" aria-labelledby="t-h"><h2 id="t-h">What has been tested ({tested.length})</h2>
  {tested.length ? <ResultsTable site={site} rows={tested} depth={1} showClaim /> : <p class="muted">No claim for this role has an outcome yet.</p>}
  {waiting.length > 0 && <p class="small muted">{waiting.length} more predicted and waiting for a trial; see the claims below or <a href="../predictions.html">the predictions</a>.</p>}
</section>

<section class="panel" aria-labelledby="c-h"><h2 id="c-h">Every claim for this role ({claims.length})</h2>
  <ClaimList site={site} claims={claims} depth={1} />
</section>
<Mentions site={site} ent={r} depth={1} />
<References ent={r} depth={1} />
</Base>
