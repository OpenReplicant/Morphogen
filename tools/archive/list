#!/usr/bin/env python3
"""List archived variants (every evals/gate run), newest first.

    tools/archive/list [--passed] [--json]

Records are annotated-tag messages written by evals/gate. Share them with:
    git push origin 'refs/tags/archive/*'
"""
import json
import subprocess
import sys

out = subprocess.run(["git", "for-each-ref", "--sort=-creatordate", "refs/tags/archive",
                      "--format=%(contents)%00"], capture_output=True, text=True).stdout
rows = []
for chunk in out.split("\0"):
    try:
        r = json.loads(chunk.strip())
    except json.JSONDecodeError:
        continue
    if "--passed" in sys.argv and not r.get("passed"):
        continue
    rows.append(r)

if "--json" in sys.argv:
    print(json.dumps(rows, indent=2))
else:
    for r in rows:
        print(f"{r['id']:<42} {'pass' if r['passed'] else 'fail':<5} "
              f"{r.get('strategy', ''):<13} {r.get('branch', ''):<26} {', '.join(r.get('failed', []))}")
