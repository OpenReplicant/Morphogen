#!/bin/sh
# Run a command against a Morphogen tree in the trial sandbox. Locked.
#
#   tools/sandbox/run [--root DIR] [--rw] -- COMMAND
#
# sandbox: docker (from map/intent.md) runs COMMAND in a container with no
# network, a read-only root filesystem, the tree mounted read-only unless --rw,
# and CPU, memory, process and time limits. sandbox: none runs it directly and
# says so on stderr.
set -eu
here=$(cd "$(dirname "$0")/../.." && pwd)
root=.
mount=ro
while [ $# -gt 0 ]; do
  case "$1" in
    --root) root=$2; shift 2 ;;
    --rw) mount=rw; shift ;;
    --) shift; break ;;
    *) break ;;
  esac
done
[ $# -gt 0 ] || { echo "usage: tools/sandbox/run [--root DIR] [--rw] -- COMMAND" >&2; exit 2; }
root=$(cd "$root" && pwd)
mode=$(sed -n 's/^sandbox:[[:space:]]*\([a-z]*\).*/\1/p' "$here/map/intent.md" | head -1)

case "${mode:-docker}" in
  none)
    echo "sandbox: none (operator setting); running unsandboxed" >&2
    cd "$root" && exec timeout 600 sh -c "$*"
    ;;
  docker)
    command -v docker >/dev/null || { echo "sandbox: docker is not installed" >&2; exit 3; }
    docker image inspect morphogen-sandbox:0.2 >/dev/null 2>&1 || {
      echo "sandbox: image missing; the operator should run tools/sandbox/build" >&2; exit 3; }
    exec timeout 660 docker run --rm \
      --network none --read-only --tmpfs /tmp:size=256m \
      --cap-drop ALL --security-opt no-new-privileges \
      --memory 2g --cpus 2 --pids-limit 256 \
      --user "$(id -u):$(id -g)" -e HOME=/tmp -v "$root:/work:$mount" -w /work \
      morphogen-sandbox:0.2 timeout 600 sh -c "$*"
    ;;
  *) echo "sandbox: unknown mode '$mode' in map/intent.md" >&2; exit 3 ;;
esac
