# Gateway for the window-manager shell and its views.
# Each view gets a subdomain; forward_auth gives SSO across all of them.
# Replace the auth placeholder with Authelia, Authentik or oauth2-proxy.

(sso) {
	# forward_auth authelia:9091 {
	# 	uri /api/authz/forward-auth
	# 	copy_headers Remote-User Remote-Groups Remote-Email
	# }
}

(frameable) {
	# Allow views to be framed by the shell only.
	header -X-Frame-Options
	header Content-Security-Policy "frame-ancestors https://morphogen.localhost"
}

morphogen.localhost {
	import sso
	# Same-origin read paths for the shell's own views.
	handle_path /api/* {
		reverse_proxy postgrest:3000
	}
	handle /review/* {
		# Decisions take the reviewer from Remote-User; forward_auth (sso) must set it.
		request_header -Remote-User
		import sso
		reverse_proxy intake:8080
	}
	handle {
		root * /srv/ui
		file_server
	}
}

intake.localhost {
	# Decisions arrive only via morphogen.localhost/review/*, where Remote-User is stripped first.
	@decisions path /review/decisions
	respond @decisions 403
	request_header -Remote-User
	import sso
	reverse_proxy intake:8080
}

api.localhost {
	import sso
	import frameable
	reverse_proxy postgrest:3000
}

# Third-party views (add when their services are in compose):
# cognee.localhost { import sso; import frameable; reverse_proxy cognee-ui:3000 }
